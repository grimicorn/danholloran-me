    <div class="nl-term-bar" data-v-32d77373=""><span class="nl-dot nl-dot-r" data-v-32d77373=""></span><span class="nl-dot nl-dot-y" data-v-32d77373=""></span><span class="nl-dot nl-dot-g" data-v-32d77373=""></span><span class="nl-term-path" data-v-32d77373="">~/subscribe</span></div>
    <form data-v-32d77373="" class="nl-term-body" novalidate="">
      <div data-v-32d77373="" id="nl-term-heading" class="nl-term-comment"> # new posts on code, craft &amp; travel — no noise, no schedule </div><label data-v-32d77373="" for="email_address" class="sr-only">Email address</label>
      <div data-v-32d77373="" class="nl-term-cmd"><span data-v-32d77373="" class="nl-term-prompt">$</span><span data-v-32d77373="" class="nl-term-flag">subscribe</span><input data-v-32d77373="" id="email_address" type="email" name="email_address" autocomplete="email" placeholder="you@domain.com"></div>
