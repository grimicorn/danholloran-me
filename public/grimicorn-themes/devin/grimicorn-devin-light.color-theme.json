    "activityBar.inactiveForeground": "#3C4C5588",
    "activityBarBadge.background": "#4475B7",
    "activityBarBadge.foreground": "#FFFFFF",
    "editorGroupHeader.tabsBackground": "#F0F0F0",
    "tab.activeBackground": "#FDFDFD",
    "tab.activeForeground": "#1A262C",
    "tab.activeBorderTop": "#4475B7",
    "tab.inactiveBackground": "#F0F0F0",
    "tab.inactiveForeground": "#3C4C5599",
    "tab.border": "#D0D0D0",
    "statusBar.background": "#E4E4E4",
    "statusBar.foreground": "#1A262C",
    "statusBar.debuggingBackground": "#B45848",
    "statusBar.debuggingForeground": "#FFFFFF",
    "statusBarItem.hoverBackground": "#00000011",
    "titleBar.activeBackground": "#E4E4E4",
    "titleBar.activeForeground": "#1A262C",
    "titleBar.inactiveBackground": "#E4E4E4",
    "titleBar.inactiveForeground": "#3C4C5599",
    "panel.background": "#F0F0F0",
    "panel.border": "#D0D0D0",
    "panelTitle.activeForeground": "#4475B7",
    "panelTitle.inactiveForeground": "#3C4C5599",
    "terminal.background": "#F0F0F0",
    "terminal.foreground": "#1A262C",
    "terminal.ansiBlack": "#1A262C",
    "terminal.ansiRed": "#B45848",
    "terminal.ansiGreen": "#2E7D32",
    "terminal.ansiYellow": "#77771C",
    "terminal.ansiBlue": "#4475B7",
    "terminal.ansiMagenta": "#6B63C8",
    "terminal.ansiCyan": "#337E85",
    "terminal.ansiWhite": "#FDFDFD",
    "terminal.ansiBrightBlack": "#3C4C55",
    "terminal.ansiBrightRed": "#E4AEA1",
    "terminal.ansiBrightGreen": "#A9CE93",
    "terminal.ansiBrightYellow": "#DADA93",
    "terminal.ansiBrightBlue": "#99BDEA",
    "terminal.ansiBrightMagenta": "#BAB5EA",
    "terminal.ansiBrightCyan": "#87C4CD",
    "terminal.ansiBrightWhite": "#FDFDFD",
    "terminalCursor.foreground": "#2E7D32",
    "input.background": "#F0F0F0",
    "input.foreground": "#1A262C",
    "input.border": "#00000022",
    "input.placeholderForeground": "#3C4C5566",
    "dropdown.background": "#F0F0F0",
    "dropdown.foreground": "#1A262C",
    "dropdown.border": "#00000022",
    "button.background": "#4475B7",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#5A90D8",
    "list.activeSelectionBackground": "#87C4CD44",
    "list.activeSelectionForeground": "#1A262C",
    "list.hoverBackground": "#EBEBEB",
    "list.highlightForeground": "#4475B7",
    "list.focusBackground": "#87C4CD22",
    "gitDecoration.addedResourceForeground": "#2E7D32",
    "gitDecoration.modifiedResourceForeground": "#77771C",
    "gitDecoration.deletedResourceForeground": "#B45848",
    "gitDecoration.untrackedResourceForeground": "#337E85",
    "gitDecoration.ignoredResourceForeground": "#3C4C5566",
    "gitDecoration.conflictingResourceForeground": "#B45848",
    "badge.background": "#4475B7",
    "badge.foreground": "#FFFFFF",
    "diffEditor.insertedTextBackground": "#2E7D3222",
    "diffEditor.removedTextBackground": "#B4584822",
    "peekView.border": "#4475B7",
    "peekViewEditor.background": "#F0F0F0",
    "peekViewResult.background": "#E4E4E4",
    "peekViewTitle.background": "#E4E4E4",
    "peekViewTitleLabel.foreground": "#1A262C",
    "scrollbarSlider.background": "#00000018",
    "scrollbarSlider.hoverBackground": "#00000030",
    "scrollbarSlider.activeBackground": "#00000044",
    "editorBracketHighlight.foreground1": "#4475B7",
    "editorBracketHighlight.foreground2": "#6B63C8",
    "editorBracketHighlight.foreground3": "#337E85",
    "editorError.foreground": "#B45848",
    "editorWarning.foreground": "#77771C",
    "editorInfo.foreground": "#337E85",
    "editorHint.foreground": "#2E7D32",
    "problemsErrorIcon.foreground": "#B45848",
    "problemsWarningIcon.foreground": "#77771C",
    "problemsInfoIcon.foreground": "#337E85"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#3C4C55",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#4475B7"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#4475B7",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6B63C8"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#2E7D32"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#337E85"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#77771C"
      }
    },
    {
      "name": "Constants & Numbers",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#337E85"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#1A262C"
      }
    },
    {
      "name": "Object Properties",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#337E85"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#1A262C"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#4475B7"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#4475B7"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#2E7D32"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#6B63C8"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#4475B7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#77771C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#6B63C8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#337E85"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#2E7D32"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#77771C",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#B45848"
      }
    }
  ],
  "editor.fontFamily": "'OperatorMonoLig-Book', 'Operator Mono Lig', monospace",
  "editor.fontSize": 16
}