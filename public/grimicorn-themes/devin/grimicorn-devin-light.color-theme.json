    "editor.wordHighlightBackground": "#87C4CD33",
    "editor.findMatchBackground": "#DADA9366",
    "editor.findMatchHighlightBackground": "#DADA9333",
    "editorCursor.foreground": "#2E7D32",
    "editorLineNumber.foreground": "#3C4C5544",
    "editorLineNumber.activeForeground": "#3C4C5599",
    "editorIndentGuide.background1": "#00000018",
    "editorIndentGuide.activeBackground1": "#00000033",
    "editorWhitespace.foreground": "#00000022",
    "editorRuler.foreground": "#00000018",
    "sideBar.background": "#F0F0F0",
    "sideBar.foreground": "#1A262C",
