    "activityBarBadge.background": "#99BDEA",
    "activityBarBadge.foreground": "#000000",
    "editorGroupHeader.tabsBackground": "#2E3C44",
    "tab.activeBackground": "#3C4C55",
    "tab.activeForeground": "#E5E5E5",
    "tab.activeBorderTop": "#99BDEA",
    "tab.inactiveBackground": "#2E3C44",
    "tab.inactiveForeground": "#BFBFBF",
    "tab.border": "#253039",
    "statusBar.background": "#253039",
    "statusBar.foreground": "#E5E5E5",
    "statusBar.debuggingBackground": "#E4AEA1",
    "statusBar.debuggingForeground": "#000000",
    "statusBarItem.hoverBackground": "#BFBFBF22",
    "titleBar.activeBackground": "#253039",
    "titleBar.activeForeground": "#E5E5E5",
    "titleBar.inactiveBackground": "#253039",
    "titleBar.inactiveForeground": "#BFBFBF",
    "panel.background": "#2E3C44",
    "panel.border": "#253039",
    "panelTitle.activeForeground": "#99BDEA",
    "panelTitle.inactiveForeground": "#BFBFBF",
    "terminal.background": "#2E3C44",
    "terminal.foreground": "#E5E5E5",
    "terminal.ansiBlack": "#253039",
    "terminal.ansiRed": "#E4AEA1",
    "terminal.ansiGreen": "#A9CE93",
    "terminal.ansiYellow": "#DADA93",
    "terminal.ansiBlue": "#99BDEA",
    "terminal.ansiMagenta": "#BAB5EA",
    "terminal.ansiCyan": "#87C4CD",
    "terminal.ansiWhite": "#BFBFBF",
    "terminal.ansiBrightBlack": "#3C4C55",
    "terminal.ansiBrightRed": "#E4AEA1",
    "terminal.ansiBrightGreen": "#A9CE93",
    "terminal.ansiBrightYellow": "#DADA93",
    "terminal.ansiBrightBlue": "#99BDEA",
    "terminal.ansiBrightMagenta": "#BAB5EA",
    "terminal.ansiBrightCyan": "#87C4CD",
    "terminal.ansiBrightWhite": "#E5E5E5",
    "terminalCursor.foreground": "#A9CE93",
    "input.background": "#2E3C44",
    "input.foreground": "#E5E5E5",
    "input.border": "#BFBFBF33",
    "input.placeholderForeground": "#BFBFBF66",
    "dropdown.background": "#2E3C44",
    "dropdown.foreground": "#E5E5E5",
    "dropdown.border": "#BFBFBF33",
    "button.background": "#99BDEA",
    "button.foreground": "#000000",
    "button.hoverBackground": "#9BBFEF",
    "list.activeSelectionBackground": "#87C4CD33",
    "list.activeSelectionForeground": "#E5E5E5",
    "list.hoverBackground": "#445060",
    "list.highlightForeground": "#99BDEA",
    "list.focusBackground": "#87C4CD22",
    "gitDecoration.addedResourceForeground": "#A9CE93",
    "gitDecoration.modifiedResourceForeground": "#DADA93",
    "gitDecoration.deletedResourceForeground": "#E4AEA1",
    "gitDecoration.untrackedResourceForeground": "#87C4CD",
    "gitDecoration.ignoredResourceForeground": "#BFBFBF55",
    "gitDecoration.conflictingResourceForeground": "#E4AEA1",
    "badge.background": "#99BDEA",
    "badge.foreground": "#000000",
    "diffEditor.insertedTextBackground": "#A9CE9322",
    "diffEditor.removedTextBackground": "#E4AEA122",
    "peekView.border": "#99BDEA",
    "peekViewEditor.background": "#2E3C44",
    "peekViewResult.background": "#253039",
    "peekViewTitle.background": "#253039",
    "peekViewTitleLabel.foreground": "#E5E5E5",
    "scrollbarSlider.background": "#BFBFBF22",
    "scrollbarSlider.hoverBackground": "#BFBFBF44",
    "scrollbarSlider.activeBackground": "#BFBFBF66",
    "editorBracketHighlight.foreground1": "#99BDEA",
    "editorBracketHighlight.foreground2": "#BAB5EA",
    "editorBracketHighlight.foreground3": "#87C4CD",
    "editorError.foreground": "#E4AEA1",
    "editorWarning.foreground": "#DADA93",
    "editorInfo.foreground": "#87C4CD",
    "editorHint.foreground": "#A9CE93",
    "problemsErrorIcon.foreground": "#E4AEA1",
    "problemsWarningIcon.foreground": "#DADA93",
    "problemsInfoIcon.foreground": "#87C4CD"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#BFBFBF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#99BDEA"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator"
      ],
      "settings": {
        "foreground": "#99BDEA",
        "fontStyle": ""
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#BAB5EA"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#A9CE93"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#87C4CD"
      }
    },
    {
      "name": "Types & Classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#DADA93"
      }
    },
    {
      "name": "Constants & Numbers",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "variable.other.constant",
        "support.constant"
      ],
      "settings": {
        "foreground": "#87C4CD"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E5E5E5"
      }
    },
    {
      "name": "Object Properties",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#87C4CD"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#E5E5E5"
      }
    },
    {
      "name": "HTML Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#99BDEA"
      }
    },
    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#99BDEA"
      }
    },
    {
      "name": "CSS Values",
      "scope": [
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#A9CE93"
      }
    },
    {
      "name": "CSS Selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#BAB5EA"
      }
    },
    {
      "name": "Markdown Heading",
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#99BDEA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DADA93",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#BAB5EA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#87C4CD"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#A9CE93"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#DADA93",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E4AEA1"
      }
    }
  ],
  "editor.fontFamily": "'OperatorMonoLig-Book', 'Operator Mono Lig', monospace",
  "editor.fontSize": 16
}