{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [".vitepress/*"],
      "@": [".vitepress"],
      "@components/*": [".vitepress/theme/components/*"],
      "@components": [".vitepress/theme/components"],
      "@theme/*": [".vitepress/theme/*"],
      "@theme": [".vitepress/theme"],
      "@typedefs/*": [".vitepress/types/*"],
      "@typedefs": [".vitepress/types"],
      "@data/*": [".vitepress/data/*"],
      "@data": [".vitepress/data"],
      "@content/*": [".vitepress/content/*"],
      "@content": [".vitepress/content"]
    }
  },
  "include": ["**/*.ts", "**/*.vue"],
  "exclude": ["node_modules", ".vitepress/dist", ".vitepress/cache"]
}
